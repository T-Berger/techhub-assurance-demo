#!/usr/bin/env python3
"""One entry point for the local customer-order privacy showcase."""
from pathlib import Path
import os
import subprocess
import sys

ROOT = Path(__file__).resolve().parent


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else "start"
    if action == "setup":
        subprocess.run(["uv", "sync", "--locked"], cwd=ROOT, check=True)
        action = "doctor"
    python = ROOT / ".venv/bin/python"
    if not python.exists():
        print("Preparing the demo environment…", flush=True)
        subprocess.run(["uv", "sync", "--locked"], cwd=ROOT, check=True)
    os.chdir(ROOT)
    os.execv(str(python), [str(python), "-m", "showcase.coordinator", action, *sys.argv[2:]])


if __name__ == "__main__":
    main()
