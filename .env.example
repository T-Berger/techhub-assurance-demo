# Copy to .env and fill in. .env is git-ignored.

# Required: model provider for the TechHub agents and the probe judge
ANTHROPIC_API_KEY=""

# Model used by every TechHub agent (see systems/techhub/config.py)
WORKSHOP_MODEL="anthropic:claude-haiku-4-5"

# Local embeddings for the policy/product vectorstore; no API key needed
EMBEDDING_PROVIDER="huggingface"

# LangSmith: needed for TechHub's own evals (evals/framework/) and LangGraph Studio.
# The probes export OTLP JSON to traces/; set TRACING="true" to also send them to LangSmith.
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="techhub-workshop"
# EU workspaces only: LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
